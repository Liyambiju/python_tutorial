     ]
    }
   ],
   "source": [
    "s = input(\"Enter a string: \")\n",
    "reverse = \"\"\n",
    "\n",
    "for char in s:\n",
    "    reverse = char + reverse\n",
    "\n",
    "print(\"Reversed string:\", reverse)\n"
   ]

   "source": [
    "## square root"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "3af0078b-73de-40e0-8871-683c45266a05",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number:  25\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Square root is: 5.0\n"
     ]
    }
   ],
   "source": [
    "num = float(input(\"Enter a number: \"))\n",
    "guess = num / 2\n",
    "\n",
    "for i in range(20):\n",
    "    guess = (guess + num / guess) / 2\n",
    "\n",
    "print(\"Square root is:\", guess)\n"
   ]
